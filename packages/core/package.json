{
    "name": "@buntui/core",
    "version": "0.1.0-alpha.7",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/AlphaFoxz/buntui.git",
        "directory": "packages/core"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./global": {
            "types": "./dist/global.d.ts",
            "default": "./dist/global.d.ts"
        },
        "./platform": {
            "browser": {
                "types": "./dist/platform/browser.d.ts",
                "default": "./dist/platform/browser.js"
            },
            "types": "./dist/platform/native.d.ts",
            "default": "./dist/platform/native.js"
        },
        "./wasm": {
            "default": "./dist/buntui.wasm"
        }
    },
    "main": "./dist/index.js",
    "browser": {
        "./dist/platform/native.js": "./dist/platform/browser.js"
    },
    "types": "./dist/index.d.ts",
    "sideEffects": false,
    "scripts": {
        "test": "bun test",
        "build": "tsc --project ./tsconfig.json && node -e \"require('fs').copyFileSync('src/global.d.ts','dist/global.d.ts')\""
    },
    "files": [
        "dist/"
    ],
    "dependencies": {
        "@buntui/native": "workspace:*",
        "@vue/reactivity": "^3.5.43"
    },
    "devDependencies": {
        "@types/bun": "=1.4.2",
        "string-width": "^8.2.2"
    }
}
