{
    "name": "github-pages",
    "version": "0.1.0-alpha.7",
    "private": true,
    "type": "module",
    "scripts": {
        "copy-wasm": "bun run scripts/copy-wasm.ts",
        "dev": "bun run copy-wasm && vite",
        "build": "bun run copy-wasm && run-p type-check \"build-only {@}\" --",
        "preview": "vite preview",
        "test:unit": "vitest",
        "build-only": "vite build",
        "type-check": "vue-tsc --build"
    },
    "dependencies": {
        "@buntui/core": "workspace:*",
        "@buntui/playground-wasm": "workspace:*",
        "@xterm/addon-fit": "^0.11.0",
        "@xterm/xterm": "^6.0.0",
        "vue": "~3.5.43",
        "vue-router": "^5.3.1"
    },
    "devDependencies": {
        "@buntui/native-wasm32-wasi": "workspace:*",
        "@tsconfig/node24": "^24.0.5",
        "@types/jsdom": "^30.0.0",
        "@types/node": "^24.19.1",
        "@vitejs/plugin-vue": "^6.0.9",
        "@vue/test-utils": "^2.5.1",
        "@vue/tsconfig": "^0.9.1",
        "jsdom": "^30.1.2",
        "npm-run-all2": "^9.0.3",
        "typescript": "npm:typescript-native-bridge@latest",
        "vite": "~8.3.2",
        "vitest": "^5.0.3",
        "vue-tsc": "~3.3.12"
    },
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    }
}
