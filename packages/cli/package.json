    "devDependencies": {
        "@buntui/native": "workspace:*",
        "@buntui/native-wasm32-wasi": "workspace:*",
        "@types/bun": "=1.4.2",
        "vite": "~8.3.2",
        "vue": "~3.5.43",
        "vue-tsc": "~3.3.12"
    },
    "peerDependencies": {
        "vite": ">=8.3.2"
