{
    "$schema": "https://opencode.ai/config.json",
    "instructions": [
        ".opencode/rules/drawlist-rendering.md",
        ".opencode/rules/event-system.md",
        ".opencode/rules/ffi-boundary.md",
        ".opencode/rules/sfc-extensions.md",
        ".opencode/rules/typescript-coding.md",
        ".opencode/rules/zig-coding.md"
    ],
    "permission": {
        "bash": {
